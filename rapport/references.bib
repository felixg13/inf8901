    author = {Xu, Kun and Ma, Li-Qian and Ren, Bo and Wang, Rui and Hu, Shimin},
    journal = {ACM Transactions on Graphics (Proceedings of SIGGRAPH Asia)},
    year = {2011},
    volume = {30},
    number = {6},
    pages = {173:1--173:10},
    doi = {10.1145/2024156.2024207},
    abstract = {Derives a compact 1D circular Gaussian approximation of the Marschner scattering function, enabling closed-form integration with spherical radial basis function environment lights and real-time editing of Marschner parameters with both single and multiple scattering}
}



