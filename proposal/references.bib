@article{davis2014generalized,
    author = {Davis, Anthony B. and Xu, Feng},
    title = {A Generalized Linear Transport Model for Spatially-Correlated Stochastic Media},
    volume = {43},
    issn = {2332-4325},
    url = {http://dx.doi.org/10.1080/23324309.2014.978083},
    doi = {10.1080/23324309.2014.978083},
    number = {1--7},
    journal = {Journal of Computational and Theoretical Transport},
    publisher = {Informa UK Limited},
    year = {2014},
    month = dec,
    pages = {474--514},
    abstract = {L'article est crucial pour reproduire Seyb et al. car il fournit la loi de transmittance en puissance pour milieux corrélés, indispensable pour modéliser le transport de lumière dans une masse de cheveux vue comme un milieu stochastique corrélé plutôt qu'un simple volume exponentiel classique. Les media stochastiques aussi appelés random media sont des éléments d'une scène qui sont représentés comme un ensemble de particules avec une position aléatoire plutôt qu'une surface déterministe.}
}

